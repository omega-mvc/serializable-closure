{
  "name": "omega-mvc/serializable-closure",
  "type": "package",
  "description": "Serializable Closure is a PHP package that allows closures to be serialized and stored, enabling their safe use in persistent storage or across requests.",
  "keywords": [
    "php",
    "serialization",
    "functional-programming",
    "php-library",
    "closures",
    "php-lib"
  ],
  "homepage": "https://omega-mvc.github.io",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Adriano Giovannini",
      "email": "agisoftt@gmail.com",
      "homepage": "https://omega-mvc.github.io",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.4"
  },
  "autoload": {
    "psr-4": {
      "Omega\\SerializableClosure\\": "src/Omega/SerializableClosure/"
    }
  },
  "scripts": {
    "phpcs": "mkdir -p cache/phpcs && XDEBUG_MODE=off php vendor/bin/phpcs",
    "phpcbf": "XDEBUG_MODE=off php vendor/bin/phpcbf --standard=PSR12",
    "phpstan": "XDEBUG_MODE=off php vendor/bin/phpstan analyse",
    "test-no-coverage": "XDEBUG_MODE=off php vendor/bin/pest --no-coverage",
    "test": "XDEBUG_MODE=coverage vendor/bin/pest --coverage"
  },
  "minimum-stability": "stable",
  "require-dev": {
    "squizlabs/php_codesniffer": "^4.0",
    "phpstan/phpstan": "^2.2",
    "pestphp/pest": "^5.1"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts-descriptions": {
    "phpcs": "Run PSR-12 checks over src/ and tests/",
    "phpstan": "Run PHPStan level 10 static analysis",
    "test": "Run the Pest test suite"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "files": ["tests/Fixtures/GlobalProbe.php"]
  }
}
