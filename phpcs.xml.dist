<?xml version="1.0"?>
<ruleset name="omega-mvc-serializable-closure">
    <description>PSR-12 coding standard for omega-mvc/serializable-closure.</description>

    <arg name="cache" value="cache/phpcs/phpcs.json"/>
    <arg name="parallel" value="4"/>

    <file>src</file>
    <file>tests</file>
    <!-- NOTE: no <exclude-pattern>vendor/*</exclude-pattern> here. Because this
         package can be checked out nested inside another project's vendor/
         directory (e.g. the omega-mvc/omega starter), a relative 'vendor/*'
         pattern matches that enclosing vendor/ path too, excluding EVERY file.
         The vendor dir is not scanned anyway since only src and tests are
         listed as <file> roots. -->
    <!-- Fixtures are test data: dense multi-symbol files by design. -->
    <exclude-pattern>tests/Fixtures/*</exclude-pattern>

    <rule ref="PSR12"/>

    <!-- Test files legitimately mix declarations and runtime work (eval-based
         fixtures, procedural dataset builders): PSR-1 side-effect sniffing
         applies to src/ only. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- PHP looks up stream-wrapper protocol methods by their exact snake_case
         names (stream_open, stream_read, ...); PSR-1 camelCase method naming
         cannot apply to Support\ClosureStream. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>src/Omega/SerializableClosure/Support/ClosureStream.php</exclude-pattern>
    </rule>
</ruleset>
