<?xml version="1.0"?>
<ruleset name="omega-mvc-serializable-closure">
    <description>PSR-12 coding standard for omega-mvc/serializable-closure.</description>

    <!-- NOTE: the element must be singular (<arg>): <args> is ignored by phpcs
         and the cache would silently never be written. -->
    <arg name="cache" value="cache/phpcs/phpcs.json"/>
    <arg name="parallel" value="8"/>

    <file>src</file>
    <file>tests</file>
    <exclude-pattern>vendor/*</exclude-pattern>

    <rule ref="PSR12"/>

    <!-- PHP looks up stream-wrapper protocol methods by their exact snake_case
         names (stream_open, stream_read, ...); PSR-1 camelCase method naming
         cannot apply to Support\ClosureStream. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>src/Omega/SerializableClosure/Support/ClosureStream.php</exclude-pattern>
    </rule>
</ruleset>
